# Supabase project URL — safe to expose to the browser (NEXT_PUBLIC_ prefix).
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon/public key — safe to expose to the browser (NEXT_PUBLIC_ prefix), relies on RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Same value as NEXT_PUBLIC_SUPABASE_URL, used by the Node-only seed script (scripts/seed.ts).
SUPABASE_URL=

# Service-role key — server/CLI-only, bypasses RLS. Never prefix with NEXT_PUBLIC_ or it will ship to the browser bundle.
SUPABASE_SERVICE_ROLE_KEY=

# Phase 2 admin bootstrap seed script (scripts/seed-admin.ts)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Cloudflare R2 — image storage (replaces Supabase Storage). Server/CLI-only
# credentials, never prefix with NEXT_PUBLIC_ or they will ship to the browser bundle.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=travelsentro-media

# Private R2 bucket for B2B contact documents (contracts and the like).
# Public access must stay OFF on this bucket: files are served only through
# short-lived signed links after a staff login check. Must not be the same
# bucket as R2_BUCKET_NAME. Needs a CORS rule allowing PUT with the
# content-type header from the site's origins (see the contacts B2C/B2B plan).
R2_PRIVATE_BUCKET_NAME=

# Public base URL for the R2 bucket (its r2.dev URL for now) — safe to expose
# to the browser (NEXT_PUBLIC_ prefix): components/admin/photo-manager.tsx
# builds thumbnail preview URLs with this client-side, right after upload.
NEXT_PUBLIC_R2_PUBLIC_URL=

# Facebook Messenger auto-greeting bot (app/api/messenger/webhook).
# Page Access Token: Meta App Dashboard -> Messenger API Settings -> "2. Generate access tokens".
MESSENGER_PAGE_ACCESS_TOKEN=

# App Secret: Meta App Dashboard -> App settings -> Basic -> "App Secret".
# Used to verify incoming webhook requests are genuinely from Meta.
MESSENGER_APP_SECRET=

# Arbitrary string that must match the "Verify token" field entered in
# Meta App Dashboard -> Messenger API Settings -> "1. Configure webhooks".
MESSENGER_VERIFY_TOKEN=

# Meta lead ads -> CRM sync (daily Vercel Cron at /api/cron/meta-leads, plus
# `npm run import:meta-leads`). Preferred: a never-expiring System User token
# (Business settings -> System users) with the Page assigned and
# leads_retrieval, pages_manage_ads, pages_read_engagement, pages_show_list,
# business_management. It is exchanged for a Page token on each run.
META_SYSTEM_USER_TOKEN=
# Fallback when META_SYSTEM_USER_TOKEN is unset: a Page access token with
# leads_retrieval. When this is unset too, MESSENGER_PAGE_ACCESS_TOKEN is used.
META_LEADS_ACCESS_TOKEN=
# Days of leads each cron run re-reads (default 7). A missed run is caught
# up as long as the gap is shorter than this.
META_LEADS_LOOKBACK_DAYS=
# Vercel sends this as a Bearer token on cron calls. Any random string, e.g.
# `openssl rand -hex 32`. Without it the cron route refuses to run.
CRON_SECRET=

# Lead follow-ups (lib/follow-ups). The daily cron (9:07 AM Manila) emails
# B2C leads still at New/Follow-up 1, 3, 5 and 10 days apart (day 1, 4, 9,
# 19), with tracked Messenger/WhatsApp buttons, and moves leads who never
# click to Lost 3 days after the last one. On by default; set to "false" to
# stop it. Staff can always send follow-ups by hand from the CRM.
FOLLOW_UPS_ENABLED=
# Max automated follow-up emails per day (default 30). The run also keeps
# 30 of Resend's 100/day free quota for auto-replies and staff sends.
FOLLOW_UP_DAILY_LIMIT=
# Leads older than this many days are left to staff (default 60).
FOLLOW_UP_MAX_LEAD_AGE_DAYS=

# Set to "true" to gate every route except /admin and /api behind the
# /coming-soon page (proxy.ts). Leave unset for the real site.
COMING_SOON_MODE=

# Meta Pixel ID (Events Manager -> Data sources -> your pixel). Safe to
# expose (NEXT_PUBLIC_). Leave unset locally/on previews to disable tracking.
NEXT_PUBLIC_META_PIXEL_ID=

# GA4 measurement ID, "G-XXXXXXXXXX" (Admin -> Data streams -> your web
# stream). Safe to expose (NEXT_PUBLIC_). Leave unset locally/on previews to
# disable tracking.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
