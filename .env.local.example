# Supabase project URL — safe to expose to the browser (NEXT_PUBLIC_ prefix).
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon/public key — safe to expose to the browser (NEXT_PUBLIC_ prefix), relies on RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Same value as NEXT_PUBLIC_SUPABASE_URL, used by the Node-only seed script (scripts/seed.ts).
SUPABASE_URL=

# Service-role key — server/CLI-only, bypasses RLS. Never prefix with NEXT_PUBLIC_ or it will ship to the browser bundle.
SUPABASE_SERVICE_ROLE_KEY=

# Phase 2 admin bootstrap seed script (scripts/seed-admin.ts)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Cloudflare R2 — image storage (replaces Supabase Storage). Server/CLI-only
# credentials, never prefix with NEXT_PUBLIC_ or they will ship to the browser bundle.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=travelsentro-media

# Public base URL for the R2 bucket (its r2.dev URL for now) — safe to expose
# to the browser (NEXT_PUBLIC_ prefix): components/admin/photo-manager.tsx
# builds thumbnail preview URLs with this client-side, right after upload.
NEXT_PUBLIC_R2_PUBLIC_URL=

# Facebook Messenger auto-greeting bot (app/api/messenger/webhook).
# Page Access Token: Meta App Dashboard -> Messenger API Settings -> "2. Generate access tokens".
MESSENGER_PAGE_ACCESS_TOKEN=

# App Secret: Meta App Dashboard -> App settings -> Basic -> "App Secret".
# Used to verify incoming webhook requests are genuinely from Meta.
MESSENGER_APP_SECRET=

# Arbitrary string that must match the "Verify token" field entered in
# Meta App Dashboard -> Messenger API Settings -> "1. Configure webhooks".
MESSENGER_VERIFY_TOKEN=

# Set to "true" to gate every route except /admin and /api behind the
# /coming-soon page (proxy.ts). Leave unset for the real site.
COMING_SOON_MODE=
