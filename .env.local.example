# Supabase project URL — safe to expose to the browser (NEXT_PUBLIC_ prefix).
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon/public key — safe to expose to the browser (NEXT_PUBLIC_ prefix), relies on RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Same value as NEXT_PUBLIC_SUPABASE_URL, used by the Node-only seed script (scripts/seed.ts).
SUPABASE_URL=

# Service-role key — server/CLI-only, bypasses RLS. Never prefix with NEXT_PUBLIC_ or it will ship to the browser bundle.
SUPABASE_SERVICE_ROLE_KEY=

# Phase 2 admin bootstrap seed script (scripts/seed-admin.ts)
ADMIN_EMAIL=
ADMIN_PASSWORD=
